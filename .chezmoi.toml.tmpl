
{{- $email := promptStringOnce . "email" "Git email address" -}}
{{- $machineType := promptChoiceOnce . "machineType" "Machine type" (list "personal" "work") -}}
{{- if not (has $machineType (list "personal" "work")) -}}
{{- fail "machineType must be personal or work" -}}
{{- end -}}


[data]
    email = {{ $email | quote }}
    machineType = {{ $machineType | quote }}


[[textconv]]
pattern = "**/*.plist"
command = "plutil"
args = ["-convert", "xml1", "-o", "-", "-"]

### This files contains machine specific variables
### They are used to drive the configuration.
### The comment is at the end because else the file gets somehow messed up
